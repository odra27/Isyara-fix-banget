# Penyaji file statis untuk app & landing di Railway. HTTPS ditangani Railway, Caddy cukup HTTP di $PORT.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# SPA: rute seperti /chat, /video/siklus-air, /login dilayani index.html.
	try_files {path} /index.html
	file_server
}
