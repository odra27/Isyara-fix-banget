# Konfigurasi Frontend Siswa (Vercel / Vite)
#
# Di Vercel, jika menggunakan rewrite vercel.json (proxy /api), VITE_API_BASE_URL
# bisa diisi "/" atau dikosongkan. Jika ingin memanggil langsung via browser,
# isi dengan URL Railway lengkap.
VITE_API_BASE_URL=/

# UUID device di tabel `devices` (dipakai untuk /api/match/sign)
VITE_DEVICE_ID=00000000-0000-4000-8000-00000000d001

# URL landing page jika di-deploy terpisah di Vercel (opsional)
# VITE_LANDING_URL=https://isyara.vercel.app

# Mode otentikasi (api = backend asli)
VITE_AUTH_MODE=api
