# Backend configuration — placeholders only. Never commit real values.
# Copy to your deployment secret store / local env; do not create a committed .env.

# PostgreSQL (Supabase Postgres) DSN
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Admin JWT verification (ADR-039). Defaults to the current deployment values if unset.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase Storage for sign references (ADR-046). Server-side only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-side-secret-never-commit>
SUPABASE_STORAGE_BUCKET=sign-references
# Staff login proxy (ADR-047 D5): public anon / publishable key for the Supabase Auth token endpoint.
SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Origin FE yang boleh memanggil API dari browser (dipisah koma). Kosongkan baris ini untuk default dev
# (http://localhost:5173, http://localhost:5174, https://localhost:5174).
# CORS_ALLOW_ORIGINS=http://localhost:5174,https://192.168.1.10:5174
# Chatbot siswa (ADR-051 D3). Kosong = chatbot mode offline (jawaban tetap "belum tersambung ke model AI").
# Server-side only, jangan pernah ditaruh di FE.
OPENROUTER_API_KEY=
# Model OpenRouter (default openrouter/auto). Contoh: google/gemini-2.0-flash-001
# OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_TIMEOUT_S=25
# OPENROUTER_SITE_URL=https://isyara.example
# Key cadangan (ADR-053), dipisah koma. Dicoba berurutan bila key sebelumnya 401/402/403/429.
# OPENROUTER_API_KEYS=
# Model cadangan, dipisah koma. Dicoba (dengan semua key) bila model utama tidak memberi jawaban.
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
